---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SOCIAL } from '../consts';

const lang = 'en' as const;
const title = `Privacy Policy | ${SITE_NAME}`;
const description = `Privacy Policy of ${SITE_NAME}: how we handle information related to your visit.`;
---

<BaseLayout lang={lang} title={title} description={description}>
  <Nav lang={lang} />
  <main class="mx-auto w-[min(100%-40px,760px)] py-16">
    <h1 class="text-4xl font-semibold tracking-[-0.05em]">Privacy Policy</h1>
    <p class="mt-2 text-[13px] text-ink-500">Last updated: August 16, 2026</p>

    <div class="mt-10 space-y-8 text-sm leading-7 text-ink-600">
      <section>
        <h2 class="text-lg font-semibold text-ink-900">1. Overview</h2>
        <p class="mt-2">
          {SITE_NAME} (the "Site") is a product introduction website. We respect and protect the
          privacy of our visitors. This policy explains how information related to your visit is
          handled. By using the Site you agree to the terms of this policy.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">2. Information We Handle</h2>
        <ul class="mt-2 list-disc space-y-1 pl-5">
          <li>
            The Site is static, offers no account registration, and does not actively collect
            personally identifiable information such as names or email addresses.
          </li>
          <li>
            The hosting platform (e.g. Cloudflare Pages) may record basic access logs (IP,
            User-Agent, etc.) under its own policies, outside our control.
          </li>
          <li>
            If analytics are enabled in the future, only anonymized usage statistics (page views,
            referrers, etc.) will be used, never to identify individuals.
          </li>
        </ul>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">3. Learning Material</h2>
        <p class="mt-2">
          The learning material shown on this Site is illustrative sample content. The Work Learn
          product itself keeps the material extracted from your conversations wherever you run it;
          this Site neither receives nor stores that material.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">4. Cookies &amp; Local Storage</h2>
        <p class="mt-2">
          The Site may use browser cookies or localStorage to remember interface preferences such as
          language. These are used solely to improve browsing and never for cross-site tracking. You
          can disable or clear them in your browser settings.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">5. Third-Party Links</h2>
        <p class="mt-2">
          The Site contains links to third-party websites such as GitHub. Their privacy practices
          are not covered by this policy; please refer to their own policies.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">6. Children</h2>
        <p class="mt-2">
          The Site is not directed at children under 14, and we do not knowingly collect personal
          information from them.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">7. Changes</h2>
        <p class="mt-2">
          This policy may be updated as the product evolves. Changes will be posted on this page
          with an updated revision date.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">8. Contact</h2>
        <p class="mt-2">
          Questions about this policy can be raised via Issues on our
          <a href={SOCIAL.github} class="font-semibold text-ink-900 underline">GitHub repository</a>
          , or by email at
          <a href={`mailto:${SOCIAL.email}`} class="font-semibold text-ink-900 underline"
            >{SOCIAL.email}</a
          >.
        </p>
      </section>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
