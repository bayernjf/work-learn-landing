---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { SITE_NAME, SOCIAL } from '../consts';

const lang = 'en' as const;
const title = `Terms of Service | ${SITE_NAME}`;
const description = `Terms of Service of ${SITE_NAME}: the agreement covering use of this site and its content.`;
---

<BaseLayout lang={lang} title={title} description={description}>
  <Nav lang={lang} />
  <main class="mx-auto w-[min(100%-40px,760px)] py-16">
    <h1 class="text-4xl font-semibold tracking-[-0.05em]">Terms of Service</h1>
    <p class="mt-2 text-[13px] text-ink-500">Last updated: August 16, 2026</p>

    <div class="mt-10 space-y-8 text-sm leading-7 text-ink-600">
      <section>
        <h2 class="text-lg font-semibold text-ink-900">1. Acceptance</h2>
        <p class="mt-2">
          Welcome to {SITE_NAME} (the "Site"). By accessing or using the Site you agree to be bound
          by these terms. If you do not agree, please do not use the Site.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">2. Site Content</h2>
        <p class="mt-2">
          Content on the Site is provided "as is" for product introduction purposes and may change
          as the product evolves. We strive for accuracy but make no express or implied warranties
          regarding completeness or timeliness.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">3. Product Availability</h2>
        <p class="mt-2">
          The product described here is still under development. Feature descriptions, interfaces,
          and access paths on the Site are subject to change, and nothing here constitutes a
          commitment to ship a specific feature on a specific date.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">4. Intellectual Property</h2>
        <p class="mt-2">
          The Site's copy, design, and branding belong to the project team and may not be used
          commercially without permission. Open-source code is governed by the license declared in
          its repository.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">5. Acceptable Use</h2>
        <p class="mt-2">
          Do not use the Site in ways that could harm or disrupt its operation or infringe on others'
          rights, including malicious scraping, injection attacks, or impersonation of the Site.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">6. Limitation of Liability</h2>
        <p class="mt-2">
          To the maximum extent permitted by law, the Site is not liable for any indirect,
          incidental, or consequential damages arising from use of or inability to use its content.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">7. Changes</h2>
        <p class="mt-2">
          These terms may be updated; changes will be posted on this page. Continued use of the Site
          constitutes acceptance of the updated terms.
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">8. Contact</h2>
        <p class="mt-2">
          Questions can be raised via Issues on our
          <a href={SOCIAL.github} class="font-semibold text-ink-900 underline">GitHub repository</a>
          , or by email at
          <a href={`mailto:${SOCIAL.email}`} class="font-semibold text-ink-900 underline"
            >{SOCIAL.email}</a
          >.
        </p>
      </section>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
