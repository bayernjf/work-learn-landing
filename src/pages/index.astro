---
const navItems = [
  { label: 'How it works', href: '#how-it-works' },
  { label: 'For every agent', href: '#every-agent' },
  { label: 'The loop', href: '#the-loop' }
];

const captureModes = [
  { title: 'Skill', copy: 'Ask your agent to save the useful parts of the conversation.', code: '整理刚才这段对话' },
  { title: 'MCP', copy: 'Give every agent the same memory, search, and review tools.', code: 'save_material()' },
  { title: 'CLI', copy: 'Capture terminal sessions when there is no native integration.', code: 'learn capture' }
];

const featureRows = [
  { number: '01', title: 'Keep the good sentence', copy: 'Work Learn finds expressions worth reusing, not every word you happened to see.', kind: 'extract' },
  { number: '02', title: 'Make it yours', copy: 'See the natural version, why it works, and an example shaped around your codebase.', kind: 'context' },
  { number: '03', title: 'Use it again', copy: 'The next practice starts from the language your work already made meaningful.', kind: 'practice' }
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Work Learn turns the English you use with AI into a personal course." />
    <title>Work Learn - Learn from the work already happening</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Work Learn home">
        <span class="wordmark-mark" aria-hidden="true">W</span>
        <span>work learn</span>
      </a>
      <nav aria-label="Main navigation">
        {navItems.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="header-link" href="#get-started">Try the skill <span aria-hidden="true">↗</span></a>
    </header>

    <main>
      <section class="hero shell">
        <div class="hero-copy">
          <p class="eyebrow">A learning layer for your AI workflow</p>
          <h1>Learn the English your work already needs.</h1>
          <p class="hero-lede">Turn conversations with AI into a personal course you can actually reuse.</p>
          <div class="hero-actions">
            <a class="button button-dark" href="#get-started">Get the skill <span aria-hidden="true">↗</span></a>
            <a class="text-link" href="#how-it-works">See how it works <span aria-hidden="true">↓</span></a>
          </div>
        </div>

        <div class="hero-stage" aria-label="A preview of a saved learning moment">
          <div class="stage-note">saved from a real conversation</div>
          <div class="conversation-window">
            <div class="window-topline"><span>claude</span><span class="window-status">learning layer on</span></div>
            <div class="message user-message">Can we decouple the validation layer from persistence?</div>
            <div class="message assistant-message">
              <span class="message-label">assistant</span>
              <p>Yes. That keeps the domain rules independent from the database adapter and makes the module easier to test.</p>
            </div>
            <div class="learning-drawer">
              <div class="drawer-heading"><span>Worth learning</span><span class="drawer-count">01</span></div>
              <p class="drawer-expression">decouple A from B</p>
              <p class="drawer-explanation">Separate two things so each can change independently.</p>
              <div class="drawer-example"><span>your next use</span> “We should decouple the API layer from the queue.”</div>
            </div>
          </div>
          <div class="stage-caption"><span class="caption-line"></span> The useful part stays close to the work.</div>
        </div>
      </section>

      <section class="signal-band shell" aria-label="Supported workflows">
        <span>Built for the way developers work</span>
        <div class="signal-items"><span>Claude</span><span>ChatGPT</span><span>Hermes</span><span>OpenClaw</span><span>your terminal</span></div>
      </section>

      <section class="section shell" id="how-it-works">
        <div class="section-intro">
          <h2>One command turns context into progress.</h2>
          <p>Work Learn sits beside your agents. You decide what is worth keeping. It does the sorting, shaping, and remembering.</p>
        </div>
        <div class="capture-grid">
          {captureModes.map((mode, index) => (
            <article class:list={["capture-item", { "capture-featured": index === 0 }]}>
              <div class="capture-number">0{index + 1}</div>
              <h3>{mode.title}</h3>
              <p>{mode.copy}</p>
              <code>{mode.code}</code>
            </article>
          ))}
        </div>
      </section>

      <section class="dark-section" id="every-agent">
        <div class="shell dark-inner">
          <div class="dark-heading">
            <p class="eyebrow eyebrow-light">The same learning layer, everywhere</p>
            <h2>Your agents can have different voices. Your learning history should not.</h2>
          </div>
          <div class="agent-map" aria-label="A map of Work Learn integrations">
            <div class="map-center"><span class="map-mark">W</span><strong>your learning</strong><small>one memory</small></div>
            <div class="map-node node-one"><strong>Skill</strong><span>understand the moment</span></div>
            <div class="map-node node-two"><strong>MCP</strong><span>save and search</span></div>
            <div class="map-node node-three"><strong>CLI</strong><span>capture the terminal</span></div>
            <div class="map-line line-one"></div><div class="map-line line-two"></div><div class="map-line line-three"></div>
          </div>
        </div>
      </section>

      <section class="section loop-section shell" id="the-loop">
        <div class="loop-heading">
          <h2>The point is not more notes.</h2>
          <p>The point is the next time you can say it without thinking.</p>
        </div>
        <div class="loop-list">
          {featureRows.map((row) => (
            <article class="loop-row">
              <span class="loop-number">{row.number}</span>
              <div><h3>{row.title}</h3><p>{row.copy}</p></div>
              <div class:list={["loop-visual", `visual-${row.kind}`]} aria-hidden="true">
                {row.kind === 'extract' && <><span class="visual-line short"></span><span class="visual-highlight">decouple A from B</span><span class="visual-line"></span></>}
                {row.kind === 'context' && <><span class="visual-label">in your work</span><span class="visual-code">API layer <b>↔</b> queue</span></>}
                {row.kind === 'practice' && <><span class="visual-label">next practice</span><span class="visual-practice">Use it in a sentence <b>→</b></span></>}
              </div>
            </article>
          ))}
        </div>
      </section>

      <section class="cta-section shell" id="get-started">
        <div class="cta-copy"><p class="eyebrow">Start with the conversations you already have</p><h2>Make your work teach you.</h2></div>
        <div class="cta-action"><p>No new curriculum. No context switching. Just the useful English, when it matters.</p><a class="button button-dark" href="mailto:hello@worklearn.app">Join the early build <span aria-hidden="true">↗</span></a></div>
      </section>
    </main>

    <footer class="site-footer shell"><a class="wordmark" href="/" aria-label="Work Learn home"><span class="wordmark-mark" aria-hidden="true">W</span><span>work learn</span></a><span>Language from the work.</span><span>© 2026 Work Learn</span></footer>
  </body>
</html>

<style>
  :root { color-scheme: light; --ink: #171918; --muted: #68706b; --paper: #f3f5f1; --line: #d7ded8; --accent: #b8f23e; --dark: #1b211f; --serif: Georgia, 'Times New Roman', serif; --sans: 'Avenir Next', 'SF Pro Display', -apple-system, BlinkMacSystemFont, sans-serif; --mono: 'SFMono-Regular', Consolas, 'Liberation Mono', monospace; }
  * { box-sizing: border-box; }
  html { scroll-behavior: smooth; }
  body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); -webkit-font-smoothing: antialiased; }
  a { color: inherit; text-decoration: none; }
  .shell { width: min(1180px, calc(100% - 64px)); margin: 0 auto; }
  .site-header { height: 76px; width: min(1310px, calc(100% - 64px)); margin: 0 auto; display: flex; align-items: center; justify-content: space-between; gap: 24px; border-bottom: 1px solid var(--line); }
  .wordmark { display: inline-flex; align-items: center; gap: 10px; font-size: 15px; font-weight: 700; letter-spacing: -.04em; }
  .wordmark-mark, .map-mark { display: grid; place-items: center; width: 25px; height: 25px; border-radius: 7px; background: var(--ink); color: var(--accent); font-size: 13px; font-weight: 800; letter-spacing: -.1em; }
  nav { display: flex; gap: 32px; margin-left: 72px; font-size: 13px; color: #505954; }
  nav a, .header-link, .text-link { transition: color .25s ease, transform .25s ease; }
  nav a:hover, .header-link:hover, .text-link:hover { color: var(--ink); }
  .header-link { font-size: 13px; font-weight: 650; }
  .header-link span, .button span { display: inline-block; margin-left: 7px; transition: transform .25s ease; }
  .header-link:hover span, .button:hover span { transform: translate(2px, -2px); }
  .hero { min-height: 650px; padding: 76px 0 88px; display: grid; grid-template-columns: minmax(0, .87fr) minmax(440px, 1.13fr); align-items: center; gap: 72px; }
  .eyebrow { margin: 0 0 22px; color: #59625d; font: 600 10px/1 var(--mono); letter-spacing: .16em; text-transform: uppercase; }
  h1, h2, h3, p { margin-top: 0; }
  h1 { max-width: 630px; margin-bottom: 25px; font-size: clamp(3.35rem, 6.3vw, 5.8rem); line-height: .92; letter-spacing: -.075em; font-weight: 600; }
  .hero-lede { max-width: 380px; margin-bottom: 34px; color: var(--muted); font-size: 17px; line-height: 1.45; letter-spacing: -.02em; }
  .hero-actions { display: flex; align-items: center; gap: 26px; }
  .button { display: inline-flex; align-items: center; justify-content: center; min-height: 48px; padding: 0 19px; border-radius: 8px; font-size: 13px; font-weight: 700; transition: transform .25s ease, background .25s ease; }
  .button-dark { color: #eff5ee; background: var(--ink); }
  .button-dark:hover { transform: translateY(-2px); background: #2c3731; }
  .text-link { font-size: 13px; font-weight: 650; color: #58615b; }
  .text-link span { margin-left: 8px; color: var(--ink); }
  .hero-stage { position: relative; padding: 28px 22px 0 28px; }
  .stage-note { position: absolute; top: 0; left: 0; color: #707873; font: 10px var(--mono); letter-spacing: .04em; }
  .conversation-window { position: relative; z-index: 1; min-height: 430px; padding: 20px; border: 1px solid #cbd4cc; border-radius: 12px; background: #fff; box-shadow: 18px 22px 0 #dce4dd; }
  .window-topline { display: flex; align-items: center; justify-content: space-between; padding-bottom: 17px; border-bottom: 1px solid #e2e7e2; font: 600 11px var(--mono); }
  .window-status { color: #7b877e; font-weight: 400; }
  .message { max-width: 82%; margin-top: 24px; padding: 14px 16px; border-radius: 9px; font-size: 13px; line-height: 1.5; }
  .user-message { margin-left: auto; background: #e9f0e9; color: #354039; }
  .assistant-message { color: #353d37; }
  .message-label { display: block; margin-bottom: 7px; color: #7b857e; font: 10px var(--mono); text-transform: uppercase; letter-spacing: .1em; }
  .assistant-message p { margin: 0; }
  .learning-drawer { margin-top: 26px; padding: 17px; border: 1px solid #d5e6b4; border-radius: 8px; background: #f4fadf; }
  .drawer-heading { display: flex; justify-content: space-between; color: #58624e; font: 10px var(--mono); text-transform: uppercase; letter-spacing: .1em; }
  .drawer-count { color: #6f8751; }
  .drawer-expression { margin: 14px 0 4px; font: 600 21px/1.1 var(--serif); letter-spacing: -.03em; }
  .drawer-explanation { margin-bottom: 14px; color: #66705e; font-size: 12px; }
  .drawer-example { padding-top: 12px; border-top: 1px solid #d7e7b9; color: #46513e; font-size: 12px; line-height: 1.45; }
  .drawer-example span { display: block; margin-bottom: 5px; color: #85976d; font: 9px var(--mono); text-transform: uppercase; letter-spacing: .1em; }
  .stage-caption { display: flex; align-items: center; gap: 9px; justify-content: flex-end; margin-top: 24px; color: #78817b; font-size: 11px; }
  .caption-line { display: inline-block; width: 32px; height: 1px; background: #aeb8b0; }
  .signal-band { display: flex; align-items: center; justify-content: space-between; padding: 24px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); color: #737c76; font: 10px var(--mono); text-transform: uppercase; letter-spacing: .08em; }
  .signal-items { display: flex; align-items: center; gap: clamp(16px, 3.2vw, 46px); color: #48534b; font: 600 13px var(--sans); text-transform: none; letter-spacing: -.02em; }
  .section { padding: 150px 0; }
  .section-intro { max-width: 610px; margin-bottom: 72px; }
  h2 { margin-bottom: 20px; font-size: clamp(2.6rem, 5vw, 4.75rem); line-height: .96; letter-spacing: -.07em; font-weight: 600; }
  .section-intro p, .loop-heading p, .cta-action p { max-width: 430px; color: var(--muted); font-size: 16px; line-height: 1.5; }
  .capture-grid { display: grid; grid-template-columns: 1.35fr 1fr 1fr; gap: 0; border-top: 1px solid var(--ink); }
  .capture-item { min-height: 290px; padding: 25px 28px 24px 0; border-right: 1px solid var(--line); }
  .capture-item + .capture-item { padding-left: 28px; }
  .capture-item:last-child { border-right: 0; }
  .capture-number { margin-bottom: 67px; color: #7f8b82; font: 10px var(--mono); }
  .capture-item h3 { margin-bottom: 12px; font-size: 22px; letter-spacing: -.05em; }
  .capture-item p { max-width: 240px; min-height: 59px; margin-bottom: 27px; color: #69736c; font-size: 13px; line-height: 1.5; }
  code { display: inline-block; padding: 8px 10px; border-radius: 5px; background: #e5ebe5; color: #556259; font: 11px var(--mono); }
  .capture-featured code { background: var(--accent); color: #354329; }
  .dark-section { overflow: hidden; background: var(--dark); color: #e9f0e8; }
  .dark-inner { min-height: 720px; padding: 145px 0 155px; display: grid; grid-template-columns: .83fr 1.17fr; align-items: center; gap: 80px; }
  .eyebrow-light { color: #a3b79e; }
  .dark-heading h2 { max-width: 520px; color: #eff4ed; }
  .agent-map { position: relative; height: 450px; }
  .map-center { position: absolute; top: 155px; left: 50%; z-index: 1; display: flex; width: 178px; height: 140px; transform: translateX(-50%); flex-direction: column; align-items: center; justify-content: center; border: 1px solid #5f6c60; border-radius: 12px; background: #26302a; box-shadow: 0 0 0 12px #202822; }
  .map-mark { width: 36px; height: 36px; margin-bottom: 12px; border-radius: 10px; background: var(--accent); color: #273424; font-size: 17px; }
  .map-center strong { font-size: 14px; letter-spacing: -.03em; }
  .map-center small { margin-top: 5px; color: #99a89b; font: 10px var(--mono); }
  .map-node { position: absolute; display: flex; min-width: 145px; padding: 13px 15px; flex-direction: column; gap: 5px; border: 1px solid #465449; border-radius: 8px; background: #222b25; }
  .map-node strong { color: #f0f4ee; font-size: 13px; }
  .map-node span { color: #91a094; font: 10px var(--mono); }
  .node-one { top: 18px; left: 3%; }.node-two { top: 218px; right: 1%; }.node-three { bottom: 20px; left: 16%; }
  .map-line { position: absolute; height: 1px; background: #526155; transform-origin: left center; }
  .line-one { top: 100px; left: 28%; width: 22%; transform: rotate(31deg); }.line-two { top: 233px; left: 64%; width: 18%; transform: rotate(-16deg); }.line-three { top: 337px; left: 30%; width: 20%; transform: rotate(-33deg); }
  .loop-section { padding-bottom: 160px; }
  .loop-heading { display: flex; align-items: end; justify-content: space-between; gap: 50px; margin-bottom: 72px; }
  .loop-heading h2 { max-width: 550px; margin-bottom: 0; }
  .loop-list { border-top: 1px solid var(--ink); }
  .loop-row { display: grid; grid-template-columns: 72px 1fr 310px; align-items: center; gap: 24px; min-height: 154px; border-bottom: 1px solid var(--line); }
  .loop-number { color: #89938b; font: 11px var(--mono); }
  .loop-row h3 { margin: 0 0 8px; font-size: 20px; letter-spacing: -.04em; }.loop-row p { max-width: 430px; margin: 0; color: var(--muted); font-size: 13px; line-height: 1.45; }
  .loop-visual { justify-self: end; width: 280px; min-height: 66px; padding: 14px; border: 1px solid var(--line); border-radius: 8px; background: #edf1ec; }
  .visual-line { display: block; width: 92%; height: 5px; margin: 8px 0; border-radius: 3px; background: #cbd4cc; }.visual-line.short { width: 40%; }.visual-highlight { display: block; width: max-content; padding: 3px 7px; border-radius: 3px; background: var(--accent); color: #435334; font: 11px var(--mono); }
  .visual-label { display: block; margin-bottom: 8px; color: #7d887f; font: 9px var(--mono); text-transform: uppercase; }.visual-code, .visual-practice { font: 13px var(--mono); }.visual-code b, .visual-practice b { color: #799751; font-weight: 400; }.visual-practice { display: flex; justify-content: space-between; }
  .cta-section { display: grid; grid-template-columns: 1.25fr .75fr; gap: 80px; padding: 116px 0 132px; border-top: 1px solid var(--line); }.cta-copy h2 { max-width: 600px; margin: 0; }.cta-action { align-self: end; }.cta-action p { margin-bottom: 28px; }.site-footer { display: flex; align-items: center; justify-content: space-between; min-height: 92px; border-top: 1px solid var(--line); color: #7a847d; font-size: 11px; }.site-footer .wordmark { color: var(--ink); }.site-footer .wordmark-mark { width: 21px; height: 21px; font-size: 11px; }
  @media (max-width: 800px) { .shell, .site-header { width: min(100% - 40px, 620px); }.site-header { height: 68px; }.site-header nav { display: none; }.hero { min-height: auto; padding: 64px 0 78px; grid-template-columns: 1fr; gap: 60px; }.hero-stage { padding-left: 12px; }.conversation-window { min-height: 400px; }.signal-band { display: block; line-height: 2; }.signal-items { flex-wrap: wrap; gap: 8px 22px; }.section { padding: 96px 0; }.capture-grid { grid-template-columns: 1fr; }.capture-item, .capture-item + .capture-item { min-height: auto; padding: 22px 0 30px; border-right: 0; border-bottom: 1px solid var(--line); }.capture-item:last-child { border-bottom: 0; }.capture-number { margin-bottom: 38px; }.capture-item p { min-height: auto; }.dark-inner { min-height: auto; padding: 95px 0 100px; grid-template-columns: 1fr; gap: 55px; }.agent-map { height: 380px; transform: scale(.86); transform-origin: top left; width: 116%; }.loop-heading, .cta-section { display: block; }.loop-heading { margin-bottom: 52px; }.loop-heading p { margin-top: 26px; }.loop-row { grid-template-columns: 30px 1fr; gap: 14px; padding: 28px 0; }.loop-visual { grid-column: 2; justify-self: start; width: 100%; max-width: 310px; }.cta-section { padding: 90px 0 100px; }.cta-action { margin-top: 36px; }.site-footer { min-height: 120px; flex-wrap: wrap; gap: 18px; padding: 26px 0; } }
  @media (prefers-reduced-motion: reduce) { html { scroll-behavior: auto; } *, *::before, *::after { animation-duration: .01ms !important; animation-iteration-count: 1 !important; transition-duration: .01ms !important; } }
</style>
