---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Hero from '../../components/Hero.astro';
import Signals from '../../components/Signals.astro';
import HowItWorks from '../../components/HowItWorks.astro';
import EveryAgent from '../../components/EveryAgent.astro';
import Loop from '../../components/Loop.astro';
import Dashboard from '../../components/Dashboard.astro';
import CTA from '../../components/CTA.astro';
import Footer from '../../components/Footer.astro';

const lang = 'zh' as const;
---

<BaseLayout lang={lang}>
  <Nav lang={lang} />
  <main>
    <Hero lang={lang} />
    <Signals lang={lang} />
    <HowItWorks lang={lang} />
    <EveryAgent lang={lang} />
    <Loop lang={lang} />
    <Dashboard lang={lang} />
    <CTA lang={lang} />
  </main>
  <Footer lang={lang} />
</BaseLayout>
