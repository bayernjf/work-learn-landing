---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
import { SITE_NAME, SOCIAL } from '../../consts';

const lang = 'zh' as const;
const title = `服务条款 | ${SITE_NAME}`;
const description = `${SITE_NAME} 服务条款：使用本站及其内容所适用的约定。`;
---

<BaseLayout lang={lang} title={title} description={description}>
  <Nav lang={lang} />
  <main class="mx-auto w-[min(100%-40px,760px)] py-16">
    <h1 class="text-4xl font-semibold tracking-[-0.05em]">服务条款</h1>
    <p class="mt-2 text-[13px] text-ink-500">最后更新：2026 年 8 月 16 日</p>

    <div class="mt-10 space-y-8 text-sm leading-7 text-ink-600">
      <section>
        <h2 class="text-lg font-semibold text-ink-900">1. 接受条款</h2>
        <p class="mt-2">
          欢迎访问 {SITE_NAME}（下称「本站」）。访问或使用本站即表示你同意受本条款约束。如不同意，请停止使用本站。
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">2. 站点内容</h2>
        <p class="mt-2">
          本站内容为产品介绍与说明，按「现状」提供，可能随产品迭代发生变化。我们努力保证信息准确，但不对内容的完整性、时效性作任何明示或暗示的保证。
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">3. 产品可用性</h2>
        <p class="mt-2">
          本站介绍的产品仍在开发中。站内的功能描述、界面与接入方式均可能调整，相关内容不构成在特定时间交付特定功能的承诺。
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">4. 知识产权</h2>
        <p class="mt-2">
          本站的文案、设计与标识归项目方所有，未经许可不得用于商业目的。涉及开源代码的部分以其仓库中声明的开源许可证为准。
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">5. 合理使用</h2>
        <p class="mt-2">
          请勿以任何可能损害、干扰本站运行或侵犯他人权益的方式使用本站，包括但不限于恶意爬取、注入攻击或冒充本站身份。
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">6. 责任限制</h2>
        <p class="mt-2">
          在法律允许的最大范围内，本站不对因使用或无法使用本站内容而产生的任何间接、附带或后果性损失承担责任。
        </p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">7. 条款变更</h2>
        <p class="mt-2">本条款可能更新，变更将在本页发布。继续使用本站即视为接受更新后的条款。</p>
      </section>

      <section>
        <h2 class="text-lg font-semibold text-ink-900">8. 联系方式</h2>
        <p class="mt-2">
          如有疑问，请通过
          <a href={SOCIAL.github} class="font-semibold text-ink-900 underline">GitHub 仓库</a>
          的 Issues 或邮件
          <a href={`mailto:${SOCIAL.email}`} class="font-semibold text-ink-900 underline"
            >{SOCIAL.email}</a
          > 与我们联系。
        </p>
      </section>
    </div>
  </main>
  <Footer lang={lang} />
</BaseLayout>
