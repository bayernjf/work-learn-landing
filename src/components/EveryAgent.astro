---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="overflow-hidden bg-ink-800 text-paper-50" id="every-agent">
  <div
    class="mx-auto grid w-[min(100%-40px,620px)] grid-cols-1 items-center gap-14 py-24 wide:min-h-[720px] wide:w-[min(1180px,calc(100%-64px))] wide:grid-cols-[0.83fr_1.17fr] wide:gap-20 wide:pt-[145px] wide:pb-[155px]"
  >
    <div>
      <p class="mb-[22px] font-mono text-[10px] font-semibold uppercase leading-none tracking-[0.16em] text-brand-200">
        {t('agents.eyebrow')}
      </p>
      <h2 class="max-w-[520px] text-[clamp(2.6rem,5vw,4.75rem)] font-semibold leading-[0.96] tracking-[-0.07em] text-paper-50">
        {t('agents.title')}
      </h2>
    </div>

    <div
      class="relative h-[380px] w-[116%] origin-top-left scale-[0.86] wide:h-[450px] wide:w-full wide:scale-100"
      aria-label={t('agents.mapLabel')}
    >
      <div
        class="absolute top-[155px] left-1/2 z-10 flex h-[140px] w-[178px] -translate-x-1/2 flex-col items-center justify-center rounded-xl border border-[#5f6c60] bg-[#26302a] shadow-[0_0_0_12px_#202822]"
      >
        <span
          class="mb-3 grid h-9 w-9 place-items-center rounded-[10px] bg-brand-500 text-[17px] font-extrabold tracking-[-0.1em] text-brand-900"
          >W</span
        >
        <strong class="text-sm tracking-[-0.03em]">{t('agents.center.title')}</strong>
        <small class="mt-[5px] font-mono text-[10px] text-[#99a89b]">{t('agents.center.sub')}</small>
      </div>

      <div
        class="absolute top-[18px] left-[3%] flex min-w-[145px] flex-col gap-[5px] rounded-lg border border-[#465449] bg-[#222b25] px-[15px] py-[13px]"
      >
        <strong class="text-[13px] text-paper-50">Skill</strong>
        <span class="font-mono text-[10px] text-[#91a094]">{t('agents.skill.sub')}</span>
      </div>
      <div
        class="absolute top-[218px] right-[1%] flex min-w-[145px] flex-col gap-[5px] rounded-lg border border-[#465449] bg-[#222b25] px-[15px] py-[13px]"
      >
        <strong class="text-[13px] text-paper-50">MCP</strong>
        <span class="font-mono text-[10px] text-[#91a094]">{t('agents.mcp.sub')}</span>
      </div>
      <div
        class="absolute bottom-5 left-[16%] flex min-w-[145px] flex-col gap-[5px] rounded-lg border border-[#465449] bg-[#222b25] px-[15px] py-[13px]"
      >
        <strong class="text-[13px] text-paper-50">CLI</strong>
        <span class="font-mono text-[10px] text-[#91a094]">{t('agents.cli.sub')}</span>
      </div>

      <div class="absolute top-[100px] left-[28%] h-px w-[22%] origin-left rotate-[31deg] bg-[#526155]"></div>
      <div class="absolute top-[233px] left-[64%] h-px w-[18%] origin-left -rotate-[16deg] bg-[#526155]"></div>
      <div class="absolute top-[337px] left-[30%] h-px w-[20%] origin-left -rotate-[33deg] bg-[#526155]"></div>
    </div>
  </div>
</section>
