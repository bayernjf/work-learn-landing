---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const rows = [
  { number: '01', title: 'loop.01.title' as const, copy: 'loop.01.copy' as const, kind: 'extract' },
  { number: '02', title: 'loop.02.title' as const, copy: 'loop.02.copy' as const, kind: 'context' },
  { number: '03', title: 'loop.03.title' as const, copy: 'loop.03.copy' as const, kind: 'practice' },
];
---

<section
  class="border-y border-paper-400 bg-paper-200/60 py-[88px] wide:py-[132px]"
  id="the-loop"
>
  <div class="mx-auto w-[min(100%-40px,620px)] text-center wide:w-[min(1180px,calc(100%-64px))]">
    <p class="mb-5 font-mono text-[10px] font-semibold uppercase leading-none tracking-[0.16em] text-ink-600">
      {t('loop.eyebrow')}
    </p>
    <h2 class="mx-auto max-w-[640px] text-[clamp(2.4rem,4.6vw,4rem)] font-bold leading-[0.98] tracking-[-0.07em]">
      {t('loop.title')}
    </h2>
    <p class="mx-auto mt-6 max-w-[480px] text-base leading-normal text-ink-500">{t('loop.subtitle')}</p>

    <ol
      class="mt-14 grid grid-cols-1 divide-y divide-paper-400 text-left wide:mt-20 wide:grid-cols-3 wide:divide-x wide:divide-y-0"
    >
      {
        rows.map((row) => (
          <li class="px-0 py-9 wide:px-9 wide:py-2 wide:first:pl-0 wide:last:pr-0">
            <div class="mb-8 font-mono text-[11px] font-semibold tracking-[0.1em] text-brand-700">
              {row.number}
            </div>
            <h3 class="mb-3 text-[24px] tracking-[-0.045em]">{t(row.title)}</h3>
            <p class="mb-7 max-w-[300px] text-[14px] leading-[1.55] text-ink-500">{t(row.copy)}</p>
            <div
              class="w-full max-w-[300px] rounded-lg border border-paper-400 bg-white/70 p-3.5"
              aria-hidden="true"
            >
              {row.kind === 'extract' && (
                <>
                  <span class="my-2 block h-[5px] w-[40%] rounded-[3px] bg-paper-400" />
                  <span class="block w-max rounded-[3px] bg-brand-500 px-[7px] py-[3px] font-mono text-[11px] text-brand-900">
                    decouple A from B
                  </span>
                  <span class="my-2 block h-[5px] w-[92%] rounded-[3px] bg-paper-400" />
                </>
              )}
              {row.kind === 'context' && (
                <>
                  <span class="mb-2 block font-mono text-[9px] uppercase text-ink-400">
                    {t('loop.visual.contextLabel')}
                  </span>
                  <span class="font-mono text-[13px]">
                    API layer <b class="font-normal text-brand-700">↔</b> queue
                  </span>
                </>
              )}
              {row.kind === 'practice' && (
                <>
                  <span class="mb-2 block font-mono text-[9px] uppercase text-ink-400">
                    {t('loop.visual.practiceLabel')}
                  </span>
                  <span class="flex justify-between font-mono text-[13px]">
                    {t('loop.visual.practice')} <b class="font-normal text-brand-700">→</b>
                  </span>
                </>
              )}
            </div>
          </li>
        ))
      }
    </ol>
  </div>
</section>
