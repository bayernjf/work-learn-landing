---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

const modes = [
  { title: 'how.mcp.title' as const, copy: 'how.mcp.copy' as const, code: 'save_material()', featured: true },
  { title: 'how.skill.title' as const, copy: 'how.skill.copy' as const, code: t('how.skill.code'), featured: false },
  { title: 'how.cli.title' as const, copy: 'how.cli.copy' as const, code: 'learn capture', featured: false },
];
---

<section
  class="mx-auto w-[min(100%-40px,620px)] py-24 wide:w-[min(1180px,calc(100%-64px))] wide:py-[150px]"
  id="how-it-works"
>
  <div class="mb-13 max-w-[610px] wide:mb-18">
    <h2 class="mb-5 text-[clamp(2.6rem,5vw,4.75rem)] font-bold leading-[0.96] tracking-[-0.07em]">
      {t('how.title')}
    </h2>
    <p class="max-w-[430px] text-base leading-normal text-ink-500">{t('how.subtitle')}</p>
  </div>

  <div class="grid grid-cols-1 gap-4 wide:grid-cols-3 wide:gap-5">
    {
      modes.map((mode, index) => (
        <article
          class:list={[
            'group relative flex flex-col rounded-2xl border p-6 transition-colors',
            mode.featured
              ? 'border-brand-500/50 bg-brand-50'
              : 'border-paper-400 bg-white hover:border-ink-300',
          ]}
        >
          <div class="mb-5 flex items-center justify-between">
            <span class="font-mono text-[10px] text-ink-400">0{index + 1}</span>
            <span
              class:list={[
                'h-1.5 w-1.5 rounded-full',
                mode.featured ? 'bg-brand-600' : 'bg-paper-400',
              ]}
              aria-hidden="true"
            ></span>
          </div>
          <h3 class="mb-2.5 text-[22px] tracking-[-0.05em]">{t(mode.title)}</h3>
          <p class="mb-7 max-w-[260px] text-[13px] leading-normal text-ink-500">{t(mode.copy)}</p>
          <div class="mt-auto">
            <code
              class:list={[
                'block w-full truncate rounded-lg px-3.5 py-3 font-mono text-[12px]',
                mode.featured
                  ? 'bg-ink-900 text-brand-300 ring-1 ring-inset ring-white/10'
                  : 'bg-paper-200 text-ink-700',
              ]}
            >
              {mode.code}
            </code>
          </div>
        </article>
      ))
    }
  </div>
</section>
