---
import { useTranslations, type Lang } from '../i18n';
import { APP_URL, MCP_REMOTE_URL, SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// Served by the app rather than raw.githubusercontent.com, which is unreachable
// from some networks. The app ships the same file it installs.
const skillUrl = `${APP_URL}/skills/work-learn/SKILL.md`;
const usageUrl = `${SOCIAL.github}/blob/main/docs/usage.md`;
const docsUrl = `${SOCIAL.github}/blob/main/docs/mcp-agent-setup.md`;

// Deliberately a preview, not instructions: the reader has no token yet, and
// every concrete config detail is maintained in the app instead of duplicated here.
const paths = [
  {
    title: t('cta.steps.agent.title'),
    steps: [t('cta.steps.agent.s1'), t('cta.steps.agent.s2'), t('cta.steps.agent.s3')],
  },
  {
    title: t('cta.steps.manual.title'),
    steps: [t('cta.steps.manual.s1'), t('cta.steps.manual.s2'), t('cta.steps.manual.s3')],
  },
];

const reasons = [
  t('cta.why.item1'),
  t('cta.why.item2'),
  t('cta.why.item3'),
  t('cta.why.item4'),
  t('cta.why.item5'),
];
---

<section
  class="scroll-mt-[69px] bg-ink-900 text-paper-50 wide:scroll-mt-[77px]"
  id="get-started"
>
  <div
    class="mx-auto grid w-[min(100%-40px,620px)] grid-cols-1 gap-12 py-[90px] wide:w-[min(1180px,calc(100%-64px))] wide:grid-cols-[1fr_1fr] wide:gap-20 wide:py-[132px]"
  >
    <div>
      <p class="mb-[22px] font-mono text-[10px] font-semibold uppercase leading-none tracking-[0.16em] text-brand-400">
        {t('cta.eyebrow')}
      </p>
      <h2 class="max-w-[600px] text-[clamp(2.6rem,5vw,4.75rem)] font-bold leading-[0.96] tracking-[-0.07em]">
        {t('cta.title')}
      </h2>
      <p class="mt-7 max-w-[430px] text-base leading-normal text-paper-300">{t('cta.copy')}</p>

      <div class="mt-9 rounded-xl border border-paper-200/15 bg-ink-800/60 px-4 py-4">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-brand-400">
          {t('cta.why.label')}
        </p>
        <p class="mt-2.5 text-[13px] leading-relaxed text-paper-200">{t('cta.why.copy')}</p>
        <ul class="mt-3 flex flex-col gap-2">
          {reasons.map((reason) => (
            <li class="flex gap-2.5 text-[12px] leading-relaxed text-paper-400">
              <span class="mt-[7px] size-1 shrink-0 rounded-full bg-brand-500" aria-hidden="true"></span>
              <span>{reason}</span>
            </li>
          ))}
        </ul>
      </div>

      <div class="mt-8 flex flex-wrap gap-4">
        <a
          class="group inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-500 px-[18px] text-[13px] font-bold text-brand-900 transition hover:-translate-y-0.5 hover:bg-brand-400"
          href={APP_URL}
        >
          {t('hero.cta.app')}
          <span class="ml-[7px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
        </a>
        <a
          class="inline-flex min-h-11 items-center justify-center rounded-lg border border-paper-200/30 px-[18px] text-[13px] font-bold text-paper-50 transition hover:-translate-y-0.5 hover:border-paper-100"
          href={skillUrl}
        >
          {t('cta.skill')}
        </a>
        <a
          class="inline-flex min-h-11 items-center justify-center px-[10px] text-[13px] font-semibold text-paper-300 underline-offset-4 transition hover:text-paper-50 hover:underline"
          href={usageUrl}
        >
          {t('cta.usage')}
        </a>
        <a
          class="inline-flex min-h-11 items-center justify-center px-[10px] text-[13px] font-semibold text-paper-300 underline-offset-4 transition hover:text-paper-50 hover:underline"
          href={docsUrl}
        >
          {t('cta.docs')}
        </a>
      </div>
    </div>

    <div class="wide:self-end">
      <div class="mb-6 overflow-hidden rounded-xl border border-brand-500/30 bg-ink-800/60">
        <div class="flex items-center justify-between gap-3 border-b border-paper-200/10 px-4 py-2.5">
          <span class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-brand-400">
            {t('cta.remote.label')}
          </span>
          <button
            type="button"
            class="mcp-copy shrink-0 rounded-md border border-paper-200/15 px-2.5 py-1 font-mono text-[11px] font-semibold text-paper-300 transition hover:bg-paper-200/10 hover:text-paper-50"
            data-copy-target="mcp-remote-url"
            data-copy-label={t('cta.config.copy')}
            data-copied-label={t('cta.config.copied')}
          >
            {t('cta.config.copy')}
          </button>
        </div>
        <code
          id="mcp-remote-url"
          class="block break-all px-4 py-3 font-mono text-[12px] leading-[1.7] text-brand-300"
        >{MCP_REMOTE_URL}</code>
        <p class="border-t border-paper-200/10 px-4 py-2.5 font-mono text-[10.5px] leading-relaxed text-paper-400">
          {t('cta.remote.tools')}
        </p>
        <p class="border-t border-paper-200/10 px-4 py-2.5 font-mono text-[10.5px] leading-relaxed text-paper-400">
          {t('cta.remote.auth')}
        </p>
        <p class="border-t border-paper-200/10 px-4 py-2.5 text-[11px] leading-relaxed text-paper-500">
          {t('cta.remote.caveat')}
        </p>
      </div>

      <div class="rounded-xl border border-brand-500/40 bg-brand-500/5 px-4 py-4">
        <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-brand-400">
          {t('cta.steps.label')}
        </p>
        <div class="mt-4 grid grid-cols-1 gap-4 wide:grid-cols-2">
          {paths.map((path) => (
            <div class="rounded-lg border border-paper-200/15 bg-ink-900/50 px-3.5 py-3.5">
              <p class="text-[13px] font-bold text-paper-100">{path.title}</p>
              <ol class="mt-2.5 flex flex-col gap-2">
                {path.steps.map((step, index) => (
                  <li class="flex gap-2 text-[11.5px] leading-relaxed text-paper-400">
                    <span class="shrink-0 font-mono text-[10px] font-semibold text-brand-400">{index + 1}</span>
                    <span>{step}</span>
                  </li>
                ))}
              </ol>
            </div>
          ))}
        </div>
        <p class="mt-4 text-[11px] leading-relaxed text-paper-400">{t('cta.steps.note')}</p>
        <a
          class="group mt-4 inline-flex min-h-11 items-center justify-center rounded-lg bg-brand-500 px-[18px] text-[13px] font-bold text-brand-900 transition hover:-translate-y-0.5 hover:bg-brand-400"
          href={APP_URL}
        >
          {t('cta.auto.cta')}
          <span class="ml-[7px] transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5" aria-hidden="true">↗</span>
        </a>
      </div>
    </div>

  </div>
</section>

<script>
  document.querySelectorAll<HTMLButtonElement>('.mcp-copy').forEach((btn) => {
    btn.addEventListener('click', async () => {
      const id = btn.dataset.copyTarget;
      const el = id ? document.getElementById(id) : null;
      if (!el) return;
      try {
        await navigator.clipboard.writeText(el.textContent ?? '');
        const original = btn.dataset.copyLabel ?? btn.textContent;
        btn.textContent = btn.dataset.copiedLabel ?? 'Copied';
        setTimeout(() => { btn.textContent = original; }, 1800);
      } catch { /* clipboard unavailable; silently ignore */ }
    });
  });

</script>
