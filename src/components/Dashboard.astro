---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section
  class="scroll-mt-[69px] border-b border-paper-400 bg-paper-100 py-[72px] wide:scroll-mt-[77px] wide:py-[132px]"
  id="dashboard"
>
  <div class="mx-auto w-[min(100%-40px,620px)] wide:w-[min(1180px,calc(100%-64px))]">
    <div class="text-center">
      <p class="mb-5 font-mono text-[10px] font-semibold uppercase leading-none tracking-[0.16em] text-ink-600">
        {t('dash.eyebrow')}
      </p>
      <h2 class="mx-auto max-w-[680px] text-[clamp(2.2rem,4.4vw,3.6rem)] font-bold leading-[1.02] tracking-[-0.06em]">
        {t('dash.title')}
      </h2>
      <p class="mx-auto mt-6 max-w-[480px] text-base leading-normal text-ink-500">{t('dash.subtitle')}</p>
    </div>

    <div class="mt-12 grid grid-cols-1 gap-4 wide:mt-16 wide:grid-cols-12 wide:gap-5">
      <!-- Patterns panel -->
      <div class="wide:col-span-5 rounded-2xl border border-paper-400 bg-white p-6 shadow-[0_1px_2px_rgba(23,25,24,0.04)]">
        <div class="mb-4 flex items-start justify-between">
          <div>
            <p class="font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-500">{t('dash.patterns.label')}</p>
            <h3 class="mt-1 text-[18px] font-semibold tracking-[-0.02em]">{t('dash.patterns.title')}</h3>
          </div>
          <span class="rounded-md border border-paper-400 px-2.5 py-1 font-mono text-[10px] text-ink-500">30d</span>
        </div>
        <p class="mb-5 text-[12.5px] leading-relaxed text-ink-400">{t('dash.patterns.sub')}</p>

        <div class="mb-5 flex flex-wrap gap-x-5 gap-y-2 font-mono text-[12px] text-ink-500">
          <span><b class="text-ink-800">12</b> materials</span>
          <span><b class="text-ink-800">8</b> questions</span>
          <span><b class="text-ink-800">23</b> expressions</span>
          <span><b class="text-ink-800">5</b> corrections</span>
        </div>

        <div class="mb-5">
          <p class="mb-2 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] text-ink-400">{t('dash.patterns.topics')}</p>
          <div class="flex flex-wrap gap-1.5">
            <span class="rounded-full border border-paper-400 bg-paper-100 px-2.5 py-0.5 text-[12px] text-ink-600">api <b class="ml-1 text-ink-800">4</b></span>
            <span class="rounded-full border border-paper-400 bg-paper-100 px-2.5 py-0.5 text-[12px] text-ink-600">migration <b class="ml-1 text-ink-800">3</b></span>
            <span class="rounded-full border border-paper-400 bg-paper-100 px-2.5 py-0.5 text-[12px] text-ink-600">debugging <b class="ml-1 text-ink-800">2</b></span>
          </div>
        </div>

        <div class="mb-4">
          <p class="mb-2 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] text-ink-400">{t('dash.patterns.expressions')}</p>
          <ul class="space-y-1.5 text-[13px] text-ink-600">
            <li class="flex gap-2"><span class="text-brand-700">→</span> decouple the API from the queue</li>
            <li class="flex gap-2"><span class="text-brand-700">→</span> take a closer look at the logs</li>
            <li class="flex gap-2"><span class="text-brand-700">→</span> roll it out behind a flag</li>
          </ul>
        </div>

        <div>
          <p class="mb-2 font-mono text-[10px] font-semibold uppercase tracking-[0.12em] text-ink-400">{t('dash.patterns.next')}</p>
          <p class="rounded-lg bg-brand-50 px-3 py-2 text-[12.5px] leading-relaxed text-brand-900">
            Pick two high-frequency expressions and reuse them in today's work chat.
          </p>
        </div>
      </div>

      <!-- Material card with practice -->
      <div class="wide:col-span-4 rounded-2xl border border-paper-400 bg-white p-6 shadow-[0_1px_2px_rgba(23,25,24,0.04)]">
        <p class="font-mono text-[11px] uppercase tracking-[0.1em] text-brand-700">api · architecture</p>
        <h3 class="mt-2 text-[20px] font-semibold leading-snug tracking-[-0.02em]">decouple the validation from the persistence layer</h3>
        <p class="mt-2 text-[13.5px] leading-relaxed text-ink-500">make the API to not couple with UI</p>

        <div class="mt-4 space-y-2 border-t border-dashed border-paper-400 pt-4 text-[13px]">
          <p><span class="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-400">{t('dash.card.better')}</span><br/><span class="text-ink-700">decouple the API from the UI</span></p>
          <p><span class="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-400">{t('dash.card.why')}</span><br/><span class="text-ink-700">"Decouple X from Y" is the fixed collocation.</span></p>
        </div>

        <button class="mt-5 inline-flex items-center gap-1.5 rounded-lg border border-paper-400 px-3 py-1.5 text-[12.5px] font-medium text-ink-700" aria-hidden="true">
          <span class="h-1.5 w-1.5 rounded-full bg-brand-500"></span>
          {t('dash.card.practice')}
        </button>

        <div class="mt-3 rounded-lg border border-paper-400 bg-paper-100 p-3">
          <p class="font-mono text-[10px] uppercase tracking-[0.1em] text-ink-400">{t('dash.patterns.next')}</p>
          <ol class="mt-2 space-y-2 text-[12px] text-ink-600">
            <li class="flex gap-2"><span class="rounded bg-brand-100 px-1.5 py-0.5 font-mono text-[10px] text-brand-800">reuse</span> Use "decouple X from Y" in a new sentence about your work.</li>
            <li class="flex gap-2"><span class="rounded bg-paper-300 px-1.5 py-0.5 font-mono text-[10px] text-ink-700">recall</span> Explain when you would say this.</li>
          </ol>
        </div>
      </div>

      <!-- Review card -->
      <div class="wide:col-span-3 rounded-2xl border border-paper-400 bg-white p-6 shadow-[0_1px_2px_rgba(23,25,24,0.04)]">
        <p class="mb-4 font-mono text-[10px] font-semibold uppercase tracking-[0.14em] text-ink-500">{t('dash.review.label')}</p>
        <div class="mb-3 flex items-baseline gap-3">
          <span class="font-mono text-[12px] text-brand-700">01</span>
          <h3 class="text-[16px] font-semibold leading-snug tracking-[-0.02em]">take a closer look at the logs</h3>
        </div>
        <p class="mb-4 text-[13px] leading-relaxed text-ink-500">I want to carefully examine the logs in detail</p>
        <p class="mb-5 text-[12.5px] italic leading-relaxed text-ink-400">{t('dash.review.copy')}</p>

        <div class="flex flex-col gap-2">
          <button class="self-start rounded-lg border border-paper-400 px-3 py-1.5 text-[12.5px] text-ink-700" aria-hidden="true">
            {t('dash.review.show')}
          </button>
        </div>
      </div>
    </div>
  </div>
</section>
