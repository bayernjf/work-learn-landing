---
import { useTranslations, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);

// The six clients @work-learn/setup detects and writes config for.
const agents = ['Codex', 'Claude Code', 'Claude Desktop', 'CodeBuddy', 'Cursor', 'OpenCode'];
---

<section
  class="mx-auto w-[min(100%-40px,620px)] border-y border-paper-400 py-6 font-mono text-[10px] leading-8 uppercase tracking-[0.08em] text-ink-400 wide:flex wide:w-[min(1180px,calc(100%-64px))] wide:items-center wide:justify-between wide:leading-normal"
  aria-label={t('signals.label')}
>
  <span>{t('signals.label')}</span>
  <div
    class="relative flex flex-wrap items-center gap-x-[22px] gap-y-2 font-sans text-[13px] font-semibold normal-case tracking-[-0.02em] text-ink-700 wide:gap-[clamp(16px,3.2vw,46px)]"
  >
    {agents.map((agent) => <span>{agent}</span>)}
    <span
      class="peer/term cursor-help border-b border-dashed border-ink-300 pb-px"
      tabindex="0"
      aria-describedby="signals-terminal-hint">{t('signals.terminal')}</span
    >
    <!-- Anchored to this row, not to the trigger: the trigger sits near the right
         edge, so a trigger-anchored tooltip pushed the document wider on narrow
         viewports and produced a horizontal scrollbar. -->
    <span
      class="pointer-events-none absolute left-0 top-full z-20 mt-2.5 w-full max-w-[300px] rounded-[10px] bg-ink-900 px-3 py-2 font-sans text-[12px] font-normal leading-[1.5] normal-case tracking-normal text-paper-100 opacity-0 shadow-[0_8px_24px_rgb(23_25_24/0.18)] transition-opacity duration-150 peer-hover/term:opacity-100 peer-focus/term:opacity-100 wide:left-auto wide:right-0"
      id="signals-terminal-hint"
      role="tooltip"
    >
      {t('signals.terminalHint')}
    </span>
    <span
      class="inline-flex items-center gap-1.5 rounded-full bg-brand-200 px-3 py-1 text-[12px] font-semibold leading-[18px] tracking-[-0.01em] text-ink-800"
    >
      <span aria-hidden="true" class="text-[13px] leading-none text-brand-900">＋</span>
      {t('signals.more')}
    </span>
  </div>
</section>
