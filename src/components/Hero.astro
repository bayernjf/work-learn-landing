---
import { useTranslations, localizePath, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath('/', lang);
---

<section
  class="mx-auto grid w-[min(100%-40px,620px)] grid-cols-1 items-center gap-15 pt-16 pb-[78px] wide:min-h-[650px] wide:w-[min(1180px,calc(100%-64px))] wide:grid-cols-[minmax(0,0.87fr)_minmax(440px,1.13fr)] wide:gap-18 wide:pt-[76px] wide:pb-[88px]"
>
  <div>
    <p class="mb-[22px] font-mono text-[10px] font-semibold uppercase leading-none tracking-[0.16em] text-ink-600">
      {t('hero.eyebrow')}
    </p>
    <h1 class="mb-[25px] max-w-[630px] text-[clamp(3.35rem,6.3vw,5.8rem)] font-semibold leading-[0.92] tracking-[-0.075em]">
      {t('hero.title')}
    </h1>
    <p class="mb-[34px] max-w-[380px] text-[17px] leading-[1.45] tracking-[-0.02em] text-ink-500">
      {t('hero.lede')}
    </p>
    <div class="flex flex-wrap items-center gap-[26px]">
      <a
        class="group inline-flex min-h-12 items-center justify-center rounded-lg bg-ink-900 px-[19px] text-[13px] font-bold text-paper-50 transition hover:-translate-y-0.5 hover:bg-ink-700"
        href={`${home}#get-started`}
      >
        {t('hero.cta.primary')}
        <span
          class="ml-[7px] inline-block transition-transform group-hover:translate-x-0.5 group-hover:-translate-y-0.5"
          aria-hidden="true">↗</span
        >
      </a>
      <a
        class="group text-[13px] font-semibold text-ink-600 transition-colors hover:text-ink-900"
        href={`${home}#how-it-works`}
      >
        {t('hero.cta.secondary')}
        <span class="ml-2 inline-block text-ink-900 transition-transform group-hover:translate-y-0.5" aria-hidden="true"
          >↓</span
        >
      </a>
    </div>
  </div>

  <div class="relative pt-7 pl-3 wide:pr-[22px] wide:pl-7" aria-label={t('hero.stage.label')}>
    <div class="absolute top-0 left-0 font-mono text-[10px] tracking-[0.04em] text-ink-400">
      {t('hero.stage.note')}
    </div>

    <div
      class="relative z-10 min-h-[400px] rounded-xl border border-[#cbd4cc] bg-white p-5 shadow-[18px_22px_0_#dce4dd] wide:min-h-[430px]"
    >
      <div class="flex items-center justify-between border-b border-paper-300 pb-[17px] font-mono text-[11px] font-semibold">
        <span>claude</span>
        <span class="font-normal text-ink-400">{t('hero.stage.status')}</span>
      </div>

      <div class="mt-6 ml-auto max-w-[82%] rounded-[9px] bg-[#e9f0e9] px-4 py-3.5 text-[13px] leading-normal text-ink-700">
        {t('hero.stage.user')}
      </div>

      <div class="mt-6 max-w-[82%] px-4 py-3.5 text-[13px] leading-normal text-ink-700">
        <span class="mb-[7px] block font-mono text-[10px] uppercase tracking-[0.1em] text-ink-400">
          {t('hero.stage.assistantLabel')}
        </span>
        <p>{t('hero.stage.assistant')}</p>
      </div>

      <div class="mt-[26px] rounded-lg border border-brand-200 bg-brand-50 p-[17px]">
        <div class="flex justify-between font-mono text-[10px] uppercase tracking-[0.1em] text-brand-800">
          <span>{t('hero.drawer.heading')}</span>
          <span class="text-brand-700">01</span>
        </div>
        <p class="mt-3.5 mb-1 font-serif text-[21px] font-semibold leading-[1.1] tracking-[-0.03em]">
          decouple A from B
        </p>
        <p class="mb-3.5 text-xs text-ink-500">{t('hero.drawer.explanation')}</p>
        <div class="border-t border-brand-200 pt-3 text-xs leading-[1.45] text-brand-900">
          <span class="mb-[5px] block font-mono text-[9px] uppercase tracking-[0.1em] text-brand-700">
            {t('hero.drawer.exampleLabel')}
          </span>
          {t('hero.drawer.example')}
        </div>
      </div>
    </div>

    <div class="mt-6 flex items-center justify-end gap-2.5 text-[11px] text-ink-400">
      <span class="inline-block h-px w-8 bg-ink-300"></span>
      {t('hero.stage.caption')}
    </div>
  </div>
</section>
