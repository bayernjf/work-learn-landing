---
import BayjfLink from '@bay/landing-ui/components/BayjfLink.astro';
import StarOnGithub from '@bay/landing-ui/components/StarOnGithub.astro';
import { useTranslations, localizePath, type Lang } from '../i18n';
import { SOCIAL } from '../consts';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const home = localizePath('/', lang);
---

<footer
  class="mx-auto flex w-[min(100%-40px,620px)] flex-wrap items-center justify-between gap-[18px] border-t border-paper-400 py-[26px] text-[11px] text-ink-400 wide:w-[min(1180px,calc(100%-64px))] wide:min-h-[92px] wide:flex-nowrap wide:py-0"
>
  <a
    class="inline-flex items-center gap-2.5 text-[15px] font-bold tracking-[-0.04em] text-ink-900"
    href={home}
    aria-label={t('nav.home')}
  >
    <img
      class="h-[21px] w-[21px] rounded-[7px] bg-ink-900 object-contain"
      src="/brand/work-learn-mark.svg"
      alt=""
      aria-hidden="true"
    />
    <span>work learn</span>
  </a>
  <span>{t('footer.tagline')}</span>
  <div class="flex items-center gap-[18px]">
    <BayjfLink size={16} class="text-[11px] text-ink-400 transition-colors hover:text-ink-900" />
    <StarOnGithub href={SOCIAL.github} size={14} class="inline-flex text-ink-400" />
  </div>
  <span>{t('footer.rights')}</span>
</footer>
